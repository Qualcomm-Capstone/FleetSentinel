{
  "type": "record",
  "name": "DlqEnvelope",
  "namespace": "io.fleetsentinel.telemetry.v1",
  "doc": "Flink Kafka DLQ 봉투. Kafka 메시지 하나에 Avro Object Container File 레코드 하나를 담아 writer schema와 원본을 함께 보존한다.",
  "fields": [
    {
      "name": "original_payload",
      "type": ["bytes", "null"],
      "doc": "실패한 Kafka value 원본. null value도 구분해 보존한다."
    },
    {
      "name": "error_class",
      "type": {
        "type": "enum",
        "name": "DlqErrorClass",
        "symbols": ["PARSE_FAILURE", "SCHEMA_VALIDATION_FAILURE", "BUSINESS_RULE_FAILURE", "SINK_WRITE_FAILURE"]
      },
      "doc": "DLQ 분류 4종: PARSE_FAILURE=Avro 디코드 실패, SCHEMA_VALIDATION_FAILURE=필드 범위·필수값 위반, BUSINESS_RULE_FAILURE=미등록 vehicle_id 등 업무 규칙 위반, SINK_WRITE_FAILURE=Kafka/ClickHouse 쓰기 재시도 상한 초과."
    },
    {
      "name": "error_detail",
      "type": "string",
      "doc": "실패 사유 상세 메시지(예외 스택·검증 실패 필드명 등). 운영자 재처리 판단 근거."
    },
    {
      "name": "source_subscription",
      "type": "string",
      "doc": "원본 Kafka topic."
    },
    {
      "name": "pipeline_step",
      "type": "string",
      "doc": "실패가 발생한 Core Stream Job 처리 단계 식별자(예: decode, schema-validate, enrich, sink-clickhouse). 관측성 상관관계 키."
    },
    {
      "name": "processing_time",
      "type": {
        "type": "long",
        "logicalType": "timestamp-micros"
      },
      "doc": "DLQ 격리가 발생한 처리 시각(processing-time), UTC epoch 마이크로초. event_time(원본 이벤트 발생 시각)과 구분되는 관측용 타임스탬프."
    },
    {
      "name": "attempt",
      "type": "int",
      "doc": "처리 시도 횟수. 현재 첫 격리는 1로 기록하며 자동 재처리 CLI는 제공하지 않는다."
    },
    {"name": "format_version", "type": "int", "default": 1},
    {"name": "source_partition", "type": ["null", "int"], "default": null},
    {"name": "source_offset", "type": ["null", "long"], "default": null},
    {"name": "source_key", "type": ["null", "bytes"], "default": null},
    {"name": "source_headers", "type": {"type": "array", "items": {
      "type": "record", "name": "KafkaHeader", "fields": [
        {"name": "key", "type": "string"},
        {"name": "value", "type": ["null", "bytes"], "default": null}
      ]
    }}, "default": [], "doc": "순서·중복 키·null 값을 포함한 원본 헤더. 잘못된 헤더는 수정 후 별도 재처리 경로로 발행한다."},
    {"name": "vehicle_id", "type": ["null", "string"], "default": null},
    {"name": "boot_id", "type": ["null", "string"], "default": null},
    {"name": "source_boot_id", "type": ["null", "string"], "default": null},
    {"name": "seq", "type": ["null", "long"], "default": null},
    {"name": "kind", "type": ["null", "string"], "default": null},
    {"name": "stream_id", "type": ["null", "string"], "default": null},
    {"name": "report_interval_ms", "type": ["null", "long"], "default": null}
  ]
}
