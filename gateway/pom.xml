<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- 4.0.x에 고정한다. Spring gRPC 1.0.3의 Boot 스타터가 4.0 정렬이고,
         1.1.x는 core만 발행돼 Boot 스타터가 없다(2026-08 확인). -->
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>io.fleetsentinel</groupId>
  <artifactId>gateway</artifactId>
  <version>0.1.0</version>
  <name>FleetSentinel Ingest Gateway</name>
  <description>차량 gRPC 업링크를 종단해 Kafka에 쓰는 stateless 수집 게이트웨이</description>

  <properties>
    <!-- API 모듈과 같은 런타임(SDD §4.1 "Java 버전이 모듈마다 다르다"). -->
    <java.version>21</java.version>
    <spring-grpc.version>1.0.3</spring-grpc.version>
    <avro.version>1.12.0</avro.version>
    <!-- BOM을 import하면 dependencyManagement만 들어오고 properties는 상속되지 않는다.
         spring-grpc-dependencies 1.0.3이 쓰는 값과 같게 직접 고정한다 — 어긋나면
         protoc 플러그인이 런타임 grpc-java와 다른 스텁을 생성한다. -->
    <grpc.version>1.77.1</grpc.version>
    <protobuf-java.version>4.33.4</protobuf-java.version>
    <!-- Boot 4.0.8 은 awssdk 를 관리하지 않는다(2026-08 확인). 직접 고정한다. -->
    <awssdk.version>2.54.6</awssdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.grpc</groupId>
        <artifactId>spring-grpc-dependencies</artifactId>
        <version>${spring-grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.grpc</groupId>
      <artifactId>spring-grpc-server-spring-boot-starter</artifactId>
    </dependency>

    <!-- Kafka 프로듀서. acks=all 콜백이 CACK의 근거다(docs/sdd.md S-7).
         Boot 4에서 Kafka 자동구성(KafkaProperties 포함)이 spring-boot-kafka 모듈로
         분리됐다 — spring-kafka만 넣으면 spring.kafka.* 바인딩이 없다. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>

    <!-- 액추에이터 + 마이크로미터: 신원 거절·CACK 지연·in-flight를 지표로 낸다.
         gRPC 포트와 별개로 HTTP가 필요하다 — LB 헬스체크와 Prometheus 스크레이프가
         gRPC 스트림 위로 올 수 없다. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- DLQ 봉투(schemas/dlq-envelope.avsc) 직렬화용.
         레코드 페이로드는 열지 않으므로 Avro는 DLQ 경로에만 쓴다. -->
    <dependency>
      <groupId>org.apache.avro</groupId>
      <artifactId>avro</artifactId>
      <version>${avro.version}</version>
    </dependency>

    <!-- 오브젝트 스토리지. MinIO 는 S3 호환이라 같은 SDK를 쓴다 —
         엔드포인트와 path-style 만 다르다.
         S3Presigner 는 이 아티팩트에 포함돼 있다(별도 s3-presigner 모듈은 없다). -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${awssdk.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.grpc</groupId>
      <artifactId>spring-grpc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <extensions>
      <!-- protoc 바이너리를 OS/arch에 맞게 내려받는다 — 로컬 protoc 설치 불필요. -->
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.1</version>
      </extension>
    </extensions>
    <plugins>
      <plugin>
        <groupId>io.github.ascopes</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <!-- 3.x의 protocVersion/binaryMavenPlugins API를 쓴다. 5.x는 protoc/plugins로
             파라미터가 바뀌었고 kind 판별자를 요구한다. -->
        <version>3.10.3</version>
        <configuration>
          <protocVersion>${protobuf-java.version}</protocVersion>
          <binaryMavenPlugins>
            <binaryMavenPlugin>
              <groupId>io.grpc</groupId>
              <artifactId>protoc-gen-grpc-java</artifactId>
              <version>${grpc.version}</version>
              <options>@generated=omit</options>
            </binaryMavenPlugin>
          </binaryMavenPlugins>
        </configuration>
        <executions>
          <execution>
            <goals><goal>generate</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- *IT 는 surefire가 잡지 않는다(*Test·Test*·*Tests·*TestCase만). 통합 테스트는
           failsafe가 verify 단계에서 돌린다 — `mvn verify`가 단위+통합 전부다. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
